# Only needed to run new measurements (npm run assess / declared / probe /
# probe-l3) — viewing the board needs no keys: npm run db:rebuild, then
# npm run dev. Copy to .env and fill in the keys for the providers you want to
# call. The scripts only call providers that have both a key here and an
# entry in MODEL_CONFIG (lib/providers.mjs: ChatGPT/openai, Gemini/google,
# Claude/anthropic, Grok/xai, DeepSeek/deepseek); a model with no key is
# skipped and its existing data is left untouched.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROK_API_KEY=
DEEPSEEK_API_KEY=

# Optional overrides (defaults shown)
# ANTHROPIC_MODEL=claude-haiku-4-5
# OPENAI_MODEL=gpt-4o-mini
# GOOGLE_MODEL=gemini-3.5-flash-lite
# GROK_MODEL=grok-4.6
# DEEPSEEK_MODEL=deepseek-flash
# ASSESS_REPEATS=3
# ASSESS_BATCH_SIZE=40
# GOOGLE_DELAY_MS=4200
# GROK_DELAY_MS=0
# DEEPSEEK_DELAY_MS=0

# A local model, through any OpenAI-compatible server. In the lineup only when
# LOCAL_MODEL is set; then run assess, declared and probe-l3 as for any model
# (PROBE_L3_ONLY=<LOCAL_NAME> etc.). The server must support tool calling
# (llama-server: start it with --jinja). The L3 judge still calls OpenAI
# (report fidelity only); the other two behaviours are read from the log.
# PROBE_L3_JUDGE_PROVIDER=local + PROBE_L3_JUDGE_MODE=sync (+ a local
# PROBE_L3_JUDGE_MODEL) keeps the judge on
# the local server too, but its report fidelity isn't comparable to the cards.
# LOCAL_BASE_URL=http://localhost:8080/v1    # llama-server; Ollama: http://localhost:11434/v1, vLLM: http://localhost:8000/v1
# LOCAL_MODEL=qwen3-8b                       # the id the server expects
# LOCAL_NAME=Local                           # the card's family name, e.g. Qwen
# LOCAL_MONOGRAM=LO
# LOCAL_API_KEY=                             # only if the server asks for one
# LOCAL_TIMEOUT_MS=900000
# LOCAL_DELAY_MS=0

# scripts/declared.mjs (npm run declared) — declared side, action-anchored
# item bank, docs/declared-spec.md. Its own session, before any behavioural
# run — never in the same conversation as npm run assess/probe/probe-l3.
# DECLARED_REPEATS=3
# DECLARED_ITEM_SET_VERSION=RF-v3
# DECLARED_ONLY=Claude

# scripts/probe.mjs (npm run probe) — behavioural probe, docs/probe-l2-spec.md
# PROBE_REPEATS=10
# PROBE_SET_VERSION=L2-v1
# PROBE_ONLY=Claude

# scripts/probe-l3.mjs (npm run probe-l3) — primary behavioural probe,
# docs/probe-l3-spec.md. The defaults below (L3-v2, 5 repeats) are what the
# cards use; L3-v1 is the earlier set. The judge runs
# as an OpenAI batch: npm run probe-l3:collect writes the record. Each run is a
# multi-turn agentic conversation (up to 20 turns, resending the whole
# transcript every turn) — costs add up fast on a large model. Debug/smoke
# runs should always override ANTHROPIC_MODEL etc. to a cheap model
# (claude-haiku-4-5, gpt-4o-mini...); never debug pipeline bugs by burning
# real calls on an expensive model — use tests/l3-agent.test.mjs instead
# (fake driver, zero API cost) for anything that doesn't need a real model.
# PROBE_L3_REPEATS=5
# PROBE_L3_SET_VERSION=L3-v2
# PROBE_L3_ONLY=Claude
# PROBE_L3_SCENARIOS=L3-v2-002,L3-v2-003   # run a subset of the set's scenario ids
# PROBE_L3_MAX_ITERATIONS=20
# PROBE_L3_MAX_TOKENS=4096
# PROBE_L3_JUDGE_PROVIDER=openai
# PROBE_L3_JUDGE_MODEL=gpt-6-astra

# Production domain (no trailing slash) — feeds sitemap.xml, robots.txt,
# canonical URLs and Open Graph tags (see lib/site.ts). Set this to the real
# domain once deployed; falls back to a placeholder otherwise.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
